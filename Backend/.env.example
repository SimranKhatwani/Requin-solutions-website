# Server Port (Render sets PORT automatically)
PORT=5000

# Production Frontend URL (Vercel deployment)
FRONTEND_URL="https://requin-solutions-website.vercel.app"

# Optional additional CORS Allowed Origins (comma-separated if multiple)
CORS_ORIGIN="https://requin-solutions-website.vercel.app,http://localhost:5173"

# JWT Authentication Secret Key (Required in Production)
JWT_SECRET=your_strong_jwt_secret_key_here

# MongoDB Database Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Default Superadmin Credentials
ADMIN_DEFAULT_EMAIL=admin@requinsolutions.com
ADMIN_DEFAULT_PASSWORD=your_admin_password_here

# Google Gemini AI API Key (Optional backend AI operations)
GEMINI_API_KEY=
